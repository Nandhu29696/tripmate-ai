# Required for the AI workflow.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Needed only for the corresponding live-data tools.
TAVILY_API_KEY=
AVIATION_STACK_API_KEY=
OPENWEATHER_API_KEY=

# Local PostgreSQL settings (keep these local-only).
POSTGRES_DB=tripmate
POSTGRES_USER=tripmate
POSTGRES_PASSWORD=tripmate-local-only
DATABASE_URL=postgresql://tripmate:tripmate-local-only@127.0.0.1:5433/tripmate?sslmode=disable
