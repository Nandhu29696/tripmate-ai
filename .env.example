# Required for the AI workflow.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Needed only for the corresponding live-data tools.
TAVILY_API_KEY=
AVIATION_STACK_API_KEY=
OPENWEATHER_API_KEY=

# Local PostgreSQL settings (keep these local-only).
POSTGRES_DB=tripmate
POSTGRES_USER=tripmate
POSTGRES_PASSWORD=tripmate-local-only
DATABASE_URL=postgresql://tripmate:tripmate-local-only@127.0.0.1:5433/tripmate?sslmode=disable

# Accounts. SESSION_SECRET is optional locally (an ephemeral key is generated and
# sessions then end whenever the app restarts).
SESSION_SECRET=

# Google sign-in (optional locally). See README "Accounts and Google sign-in".
# Authorized redirect URI to register in Google Cloud:
#   http://127.0.0.1:8000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email (confirmation and password-reset links). With SMTP_HOST empty the message
# is written to the app log instead, so you can copy the link while developing.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Admin console and logs ---
# Comma-separated emails that become administrators once the address is verified.
ADMIN_EMAILS=
# Keep a ring of recent SQL statements (text and timing only, never values) and flag slow ones.
LOG_SQL=true
SLOW_QUERY_MS=200
# API request log rows are deleted after this many days.
LOG_RETENTION_DAYS=14
# Optional rotating log file (5 x 5 MB), in addition to the console.
# LOG_FILE=tripmate.log

# --- Defaults for plans ---
# Where trips start when the request does not say, and the currency for amounts.
DEFAULT_ORIGIN_COUNTRY=India
DEFAULT_ORIGIN_CITY=Delhi
DEFAULT_CURRENCY=INR
