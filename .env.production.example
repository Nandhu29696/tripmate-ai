# Copy this file to .env.production on the VPS and fill in real values.
# Never commit .env.production or place production credentials in the image.

GROQ_API_KEY=replace_with_a_real_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b

# PostgreSQL must already exist on the VPS and listen on 127.0.0.1:5432.
# URL-encode special characters in the database password.
DATABASE_URL=postgresql://tripmate_user:replace_with_url_encoded_password@127.0.0.1:5432/tripmate?sslmode=disable

# Required: signs session cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=replace_with_a_long_random_secret


# Required: the public https URL of the site (no trailing slash). Used for the Google
# redirect URI and for links in emails, so they can never be built from a forged Host header.
PUBLIC_BASE_URL=https://tripmate-ai.jagoindia.in

# Google sign-in. Register this redirect URI in Google Cloud:
#   https://tripmate-ai.jagoindia.in/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Outgoing email for confirmation and password-reset links. Without SMTP_HOST the links
# are only written to the log, so email sign-up is unusable in production.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=TripMate AI <no-reply@jagoindia.in>

# Optional provider keys. Add them only if the corresponding tools are enabled.
TAVILY_API_KEY=
AVIATION_STACK_API_KEY=
OPENWEATHER_API_KEY=

# Optional tuning (defaults shown)
# MAX_PLANS_PER_USER_PER_HOUR=5
# MAX_PLANS_PER_DAY=300
# RETENTION_DAYS=30
# MAX_REVISIONS=2
# GUARDRAIL_FAIL_OPEN=false
# LLM_TIMEOUT_SECONDS=60
# LLM_OUTPUT_TOKENS_ITINERARY=2000
# LLM_OUTPUT_TOKENS_FINAL=2600
# LLM_REASONING_EFFORT=low   # for gpt-oss models; empty disables

# --- Admin console and logs ---
# Comma-separated emails that become administrators once the address is verified.
ADMIN_EMAILS=
# Keep a ring of recent SQL statements (text and timing only, never values) and flag slow ones.
LOG_SQL=true
SLOW_QUERY_MS=200
# API request log rows are deleted after this many days.
LOG_RETENTION_DAYS=14
# Optional rotating log file (5 x 5 MB), in addition to the console.
# LOG_FILE=tripmate.log

# --- Defaults for plans ---
# Where trips start when the request does not say, and the currency for amounts.
DEFAULT_ORIGIN_COUNTRY=India
DEFAULT_ORIGIN_CITY=Delhi
DEFAULT_CURRENCY=INR
