# Copy this file to .env.production on the VPS and fill in real values.
# Never commit .env.production or place production credentials in the image.

GROQ_API_KEY=replace_with_a_real_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b

# PostgreSQL must already exist on the VPS and listen on 127.0.0.1:5432.
# URL-encode special characters in the database password.
DATABASE_URL=postgresql://tripmate_user:replace_with_url_encoded_password@127.0.0.1:5432/tripmate?sslmode=disable

# Required: signs session cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=replace_with_a_long_random_secret

# Strongly recommended: users must enter this key to use the app.
# Leave empty only for an open demo (usage is then limited by the quotas below).
APP_ACCESS_KEY=

# Optional provider keys. Add them only if the corresponding tools are enabled.
TAVILY_API_KEY=
AVIATION_STACK_API_KEY=
OPENWEATHER_API_KEY=

# Optional tuning (defaults shown)
# MAX_PLANS_PER_SESSION_PER_HOUR=5
# MAX_PLANS_PER_DAY=300
# RETENTION_DAYS=30
# MAX_REVISIONS=2
# GUARDRAIL_FAIL_OPEN=false
# LLM_TIMEOUT_SECONDS=60
# LLM_OUTPUT_TOKENS_ITINERARY=2000
# LLM_OUTPUT_TOKENS_FINAL=2600
# LLM_REASONING_EFFORT=low   # for gpt-oss models; empty disables
